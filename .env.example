# Copy to .env and fill in. Never commit .env.

# Supabase (project settings > API)
SUPABASE_URL=
# Server only. Bypasses row-level security. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Safe for the browser only when row-level security is on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web search (optional, step for expansion news)
EXA_API_KEY=
KEENABLE_API_KEY=
