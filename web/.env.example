# Copy to web/.env (ignored by Git). Use a local database for now. Do not point this at
# Supabase before row-level security is on for every table (see README.md).
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Folder with the pipeline output (default: the repository root)
PIPELINE_DIR=
# CSV with contacts from the lookup step. Personal data. Never commit it.
CONTACTS_CSV=
